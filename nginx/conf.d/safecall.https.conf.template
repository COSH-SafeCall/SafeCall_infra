limit_req_zone $binary_remote_addr zone=safecall_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=safecall_auth:10m rate=120r/m;
limit_conn_zone $binary_remote_addr zone=safecall_conn:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 80;
    server_name api.dev-safecall.r-e.kr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name api.dev-safecall.r-e.kr;

    ssl_certificate /etc/letsencrypt/live/api.dev-safecall.r-e.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.dev-safecall.r-e.kr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location = /api/v1/auth/guest {
        limit_req zone=safecall_api burst=40 nodelay;
        limit_req zone=safecall_auth burst=100 nodelay;
        limit_conn safecall_conn 50;
        include /etc/nginx/conf.d/safecall-proxy.inc;
    }

    location = /api/v1/auth/virtual {
        limit_req zone=safecall_api burst=40 nodelay;
        limit_req zone=safecall_auth burst=100 nodelay;
        limit_conn safecall_conn 50;
        include /etc/nginx/conf.d/safecall-proxy.inc;
    }

    location ^~ /api/ {
        limit_req zone=safecall_api burst=40 nodelay;
        limit_conn safecall_conn 50;
        include /etc/nginx/conf.d/safecall-proxy.inc;
    }

    location / {
        include /etc/nginx/conf.d/safecall-proxy.inc;
    }
}
